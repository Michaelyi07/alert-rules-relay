# Copy to .live_webhooks.env (gitignored) and fill with your OWN test-group webhooks.
# The drill reads these into the relay child process env; it never prints or logs them.
# Leave a line empty / commented out to skip that channel.

# Feishu: group settings -> bots -> add custom bot -> copy the webhook URL.
FEISHU_WEBHOOK_URL=

# WeCom: group settings -> group robots -> add a robot -> copy the webhook URL.
WECOM_WEBHOOK_URL=
